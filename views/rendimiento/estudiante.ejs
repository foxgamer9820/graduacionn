<%- include('../partials/inicioApp', { titulo: titulo }) %>
<% var enlaceIntento = base === '/estudiante' ? '/estudiante/resultados/' : '/docente/rendimiento/intentos/'; %>
<% if (volver) { %><a class="enlace-boton" href="<%= volver %>" style="display:inline-flex; gap:4px; align-items:center; margin-bottom:12px"><%- icono('MdArrowBack') %> Volver a rendimiento</a><% } %>
<% if (est) { %>
  <div class="tema-tarjeta" style="margin-bottom:18px"><span class="avatar"><%= iniciales(est.nombres, est.apellidos) %></span>
    <div><h2 class="saludo" style="margin:0"><%= est.nombres %> <%= est.apellidos %></h2><small style="color:var(--gris-texto)">DNI <%= est.dni %> · Último acceso: <%= fecha(est.ultimo_acceso, true) %></small></div></div>
<% } %>
<%- include('_resumen', { resumen: resumen, grafica: grafica, intentos: intentos, enlaceIntento: enlaceIntento, vacio: est ? 'Todavía no ha terminado ningún test.' : 'Cuando termines tu primer test, aquí verás tu avance.' }) %>
<%- include('../partials/finApp') %>
